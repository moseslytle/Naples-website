---
import { Image } from 'astro:assets';
import aboutPractice from '../assets/images/about-practice.webp';
import conciergeConsultation from '../assets/images/concierge-consultation.webp';
import contactExterior from '../assets/images/contact-exterior.webp';
import newPatientsWelcome from '../assets/images/new-patients-welcome.webp';
import practiceHero from '../assets/images/practice-hero.webp';
import providerPortrait from '../assets/images/provider-portrait.webp';
import servicesCare from '../assets/images/services-care.webp';

interface Props {
  src: string;
  alt: string;
  portrait?: boolean;
  eager?: boolean;
  objectPosition?: string;
}

const {
  src,
  alt,
  portrait = false,
  eager = false,
  objectPosition = portrait ? 'center top' : 'center',
} = Astro.props;

const imageMap = {
  '/images/about-practice.webp': aboutPractice,
  '/images/concierge-consultation.webp': conciergeConsultation,
  '/images/contact-exterior.webp': contactExterior,
  '/images/new-patients-welcome.webp': newPatientsWelcome,
  '/images/practice-hero.webp': practiceHero,
  '/images/provider-portrait.webp': providerPortrait,
  '/images/services-care.webp': servicesCare,
};

const image = imageMap[src as keyof typeof imageMap];

if (!image) {
  throw new Error(`Unknown practice image: ${src}`);
}
---

<div class:list={['practice-image', { 'practice-image--portrait': portrait }]}>
  <Image
    class="practice-photo"
    src={image}
    alt={alt}
    priority={eager}
    style={`object-position: ${objectPosition};`}
  />
</div>

<style>
  .practice-image {
    min-height: 22rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--mist);
    box-shadow: var(--shadow);
    transition:
      box-shadow 280ms ease-out,
      transform 280ms ease-out;
  }

  :global(.practice-photo) {
    width: 100%;
    height: 100%;
    min-height: 22rem;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 500ms ease-out;
  }

  .practice-image--portrait,
  .practice-image--portrait :global(.practice-photo) {
    min-height: 30rem;
  }

  .practice-image--portrait :global(.practice-photo) {
    aspect-ratio: 4 / 5;
  }

  @media (hover: hover) {
    .practice-image:hover {
      box-shadow: 0 20px 52px rgba(24, 52, 50, 0.12);
      transform: translateY(-1px);
    }

    .practice-image:hover :global(.practice-photo) {
      transform: scale(1.008);
    }
  }

  @media (max-width: 760px) {
    .practice-image,
    :global(.practice-photo) {
      min-height: 18rem;
    }

    .practice-image--portrait,
    .practice-image--portrait :global(.practice-photo) {
      min-height: 26rem;
    }
  }
</style>
