---
import { Image } from 'astro:assets';
import darkLogo from '../assets/images/logo-black.webp';
import lightLogo from '../assets/images/logo-white.webp';

interface Props {
  variant?: 'dark' | 'light';
}

const { variant = 'dark' } = Astro.props;
const logo = variant === 'light' ? lightLogo : darkLogo;
---

<Image
  class="mark"
  src={logo}
  alt=""
  width="48"
  height="52"
  loading={variant === 'dark' ? 'eager' : 'lazy'}
/>

<style>
  :global(.mark) {
    width: 2.6rem;
    height: 2.85rem;
    object-fit: contain;
    flex: 0 0 auto;
  }
</style>
