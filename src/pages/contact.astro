---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PracticeImage from '../components/PracticeImage.astro';
import ContactLink from '../components/ContactLink.astro';
import ActionLink from '../components/ActionLink.astro';
import { practice } from '../data/practice';
---

<BaseLayout
  title="Contact & Directions"
  description="Contact details, location, and directions for Naples Modern Choice Medicine in Naples, Florida."
>
  <PageHero
    eyebrow="Contact & location"
    title="Contact the office."
    intro="Call or use the patient communication email for general questions and next steps. Online booking is not available on this website."
    ><div class="button-row">
      <a class="button" href={practice.phone.href}>Call the Practice</a>
    </div></PageHero
  >
  <section class="section">
    <div class="container contact-grid">
      <div class="card">
        <h2>Office details</h2><ul class="contact-list">
          <li>
            <strong>Address</strong><address>
              {practice.address.street}<br />{practice.address.cityStateZip}
            </address>
          </li><li>
            <ContactLink
              href={practice.phone.href}
              label="Phone"
              value={practice.phone.display}
            />
          </li><li><strong>Fax</strong>{practice.fax}</li><li>
            <ContactLink
              href={practice.email.href}
              label="Patient communication email"
              value={practice.email.display}
            />
          </li>
        </ul><div class="button-row">
          <a class="button" href={practice.phone.href}>Call the Practice</a><a
            class="button button--secondary"
            href={practice.mapUrl}
            target="_blank"
            rel="noopener noreferrer"
            >Get Directions<span class="sr-only"> (opens in a new tab)</span></a
          >
        </div>
        <div class="member-payment">
          <h3>Member payments</h3>
          <p>
            Make a payment through the practice’s PayerExpress payment portal.
          </p>
          <ActionLink href={practice.paymentUrl} external>Pay Now</ActionLink>
          <p class="member-payment__note">Opens PayerExpress in a new tab.</p>
        </div>
      </div><PracticeImage
        src="/images/contact-exterior.webp"
        alt="Naples Modern Choice Medicine sign on the office building"
      />
    </div>
  </section>
  <section class="section section--sand">
    <div class="narrow prose">
      <h2>Before you contact us</h2><p>
        Do not use email for emergencies. Call 911 in an emergency.
      </p><p>
        Follow office guidance before sending medical or other sensitive
        personal information. This public website does not provide a secure
        contact or intake form.
      </p>
    </div>
  </section>
</BaseLayout>
<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }
  .contact-grid h2 {
    font-size: clamp(2rem, 3vw, 2.75rem);
  }
  .contact-grid > :global(.practice-image) {
    --image-ratio: 3 / 2;
  }
  address {
    font-style: normal;
  }
  .member-payment {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .member-payment h3 {
    font-size: 1.75rem;
  }
  .member-payment p {
    max-width: 38ch;
    color: var(--ink-soft);
  }
  .member-payment .member-payment__note {
    margin: 0.75rem 0 0;
    font-size: 0.8125rem;
  }
  @media (max-width: 760px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .contact-grid > :global(.practice-image) {
      --image-ratio: 3 / 2;
    }
  }
</style>
