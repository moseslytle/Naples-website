---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { practice, sitePath } from '../data/practice';

const faqs = [
  {
    q: 'What is Naples Modern Choice Medicine?',
    a: 'It is a concierge family medicine practice located in Naples, Florida.',
  },
  {
    q: 'What is concierge family medicine?',
    a: 'Concierge family medicine uses a membership model to support more personalized, ongoing primary care with enhanced access to your physician.',
  },
  {
    q: 'How is concierge medicine different from a traditional primary care practice?',
    bullets: [
      'Smaller patient panel',
      'Longer appointments',
      'Direct communication with your physician',
      'Focus on prevention and wellness',
    ],
  },
  {
    q: 'Do you accept insurance?',
    a: 'No. Your membership fee is not paid through insurance. However, all patients must maintain health insurance to cover other aspects of their healthcare, including, but not limited to, prescriptions, imaging and labs, specialists, hospitalization, and emergency care.',
  },
  {
    q: 'How do I become a member?',
    a: 'For more information on becoming a member, please contact the office at (239) 499-4765. Membership availability is limited.',
  },
  {
    q: 'Can I book an appointment online?',
    a: 'No. This website does not offer online booking. Please contact the office directly.',
  },
  {
    q: 'Is this website for medical emergencies?',
    a: 'No. Call 911 in an emergency. Do not rely on this website or email for urgent or emergency care.',
  },
  {
    q: 'Can I purchase medications through the website?',
    a: 'No. Medications and pharmaceuticals are not sold through this website.',
  },
];
---

<BaseLayout
  title="Frequently Asked Questions"
  description="Answers to general questions about Naples Modern Choice Medicine, concierge care, contact, and website safety."
>
  <PageHero
    eyebrow="Frequently asked questions"
    title="Straightforward answers to common questions."
    intro="Find general information here, then contact the office for questions about the practice."
  />
  <section class="section">
    <div class="narrow faq-list">
      {
        faqs.map((faq, index) => (
          <details open={index === 0}>
            <>
              <summary>{faq.q}</summary>
              <div class="answer">
                {faq.a && <p>{faq.a}</p>}
                {faq.bullets && (
                  <ul>
                    {faq.bullets.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
              </div>
            </>
          </details>
        ))
      }
    </div>
  </section>
  <section class="section section--mist">
    <div class="narrow">
      <h2>Still have a general question?</h2><p>
        Call the office at <a href={practice.phone.href}
          >{practice.phone.display}</a
        >.
      </p><div class="button-row">
        <a class="button" href={sitePath('/contact/')}>Contact the Office</a>
      </div>
    </div>
  </section>
</BaseLayout>
<script>
  const motionPreference = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  );
  document
    .querySelectorAll<HTMLDetailsElement>('.faq-list details')
    .forEach((details) => {
      const summary = details.querySelector('summary');
      const answer = details.querySelector<HTMLElement>('.answer');
      let animation: Animation | undefined;
      let expanded = details.open;
      summary?.addEventListener('click', (event) => {
        if (!summary || !answer || !('animate' in details)) return;
        event.preventDefault();
        expanded = !(animation ? expanded : details.open);
        const startHeight = details.getBoundingClientRect().height;
        animation?.cancel();
        if (motionPreference.matches) {
          details.open = expanded;
          return;
        }
        details.open = true;
        // Keep the native disclosure and its keyboard behavior; animate only height.
        const endHeight = expanded
          ? details.getBoundingClientRect().height
          : summary.getBoundingClientRect().height + 1;
        animation = details.animate(
          { height: [`${startHeight}px`, `${endHeight}px`] },
          { duration: 260, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
        );
        animation.onfinish = () => {
          details.open = expanded;
          animation = undefined;
        };
      });
      motionPreference.addEventListener('change', (event) => {
        if (event.matches) animation?.finish();
      });
    });
</script>
<style>
  .faq-list {
    border-top: 1px solid var(--border);
  }
  details {
    border-bottom: 1px solid var(--border);
    overflow: clip;
  }
  summary {
    position: relative;
    min-height: 4.5rem;
    padding: 1.75rem 3rem 1.75rem 0.25rem;
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 400;
    line-height: 1.4;
    list-style: none;
    transition:
      color 200ms ease-out,
      background-color 200ms ease-out;
  }
  summary:hover {
    color: var(--pine);
    background-color: rgb(36 68 56 / 4%);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::before,
  summary::after {
    position: absolute;
    top: 2.4rem;
    right: 0.75rem;
    width: 0.8rem;
    height: 1px;
    background: var(--pine);
    content: '';
    transition: transform 220ms ease;
  }
  summary::after {
    transform: rotate(90deg);
  }
  details[open] summary::after {
    transform: rotate(0);
  }
  summary:focus-visible {
    outline-offset: -4px;
    outline-color: var(--pine);
    background-color: rgb(36 68 56 / 4%);
    box-shadow: none;
  }
  .answer {
    padding: 0 3rem 1.75rem 0.25rem;
    color: var(--ink-soft);
  }
  .answer :last-child {
    margin-bottom: 0;
  }
</style>
