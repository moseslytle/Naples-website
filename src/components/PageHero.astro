---
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
    </div>
    <div class="page-hero__intro">
      <p class="lede">{intro}</p>
      <slot />
    </div>
  </div>
</section>

<style>
  .page-hero {
    padding-block: clamp(4.5rem, 7vw, 7.5rem);
    border-bottom: 1px solid var(--border);
    background: var(--cream);
  }

  .page-hero .container {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(20rem, 0.72fr);
    align-items: end;
    gap: clamp(3rem, 8vw, 8rem);
  }
  h1 {
    max-width: 16ch;
    margin: 0;
  }
  .page-hero__intro {
    max-width: 34rem;
    padding-bottom: 0.35rem;
  }
  .page-hero__intro :global(p:last-child) {
    margin-bottom: 0;
  }
  .eyebrow {
    color: var(--coral);
  }
  .page-hero__intro :global(.lede) {
    font-size: 1rem;
  }
  .page-hero__intro :global(.button-row) {
    margin-top: 2rem;
  }
  @media (max-width: 760px) {
    .page-hero {
      padding-block: 4.5rem;
    }
    .page-hero .container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    h1 {
      max-width: 18ch;
    }
    .page-hero__intro {
      max-width: 38rem;
      padding-bottom: 0;
    }
  }
</style>
