---
import BaseLayout from '../layouts/BaseLayout.astro';
import PracticeImage from '../components/PracticeImage.astro';
import ContactCard from '../components/ContactCard.astro';
import { practice } from '../data/practice';
---

<BaseLayout
  title={practice.name}
  description="A welcoming introduction to Naples Modern Choice Medicine, a concierge family medicine practice in Naples, Florida."
>
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <p class="eyebrow">Concierge family medicine · Naples, Florida</p>
        <h1>A more personal approach to family medicine.</h1>
        <p class="lede">
          Naples Modern Choice Medicine offers concierge family medicine with
          more time for thoughtful, ongoing care and a closer relationship with
          your physician.
        </p>
        <div class="button-row">
          <a class="button" href={practice.phone.href}>Call the Practice</a>
          <a class="button button--secondary" href="/concierge-care/"
            >Learn About Concierge Care</a
          >
        </div>
        <p class="hero__note">
          Appointments are arranged by contacting the office. Online booking is
          not available.
        </p>
      </div>
      <PracticeImage
        src="/images/practice-hero.webp"
        alt="Naples Modern Choice Medicine office building and entrance"
        eager
      />
    </div>
  </section>

  <section class="section intro">
    <div class="narrow">
      <p class="eyebrow">A thoughtful approach to primary care</p>
      <h2>What concierge family medicine means</h2>
      <p class="lede">
        Concierge family medicine uses a membership model to support more
        personalized, ongoing primary care. Membership details, access, and
        included services vary by practice.
      </p>
      <div class="button-row">
        <a class="button button--secondary" href="/concierge-care/"
          >How Concierge Care Works</a
        >
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <PracticeImage
        src="/images/provider-portrait.webp"
        alt="Dr. Sandy Naples"
        portrait
      />
      <div>
        <p class="eyebrow">Meet your provider</p>
        <h2>Meet Dr. Sandy Naples.</h2>
        <p>
          Sandy P. Naples, D.O., F.A.A.F.P., is a board-certified family
          physician with more than 30 years of experience in family medicine.
        </p>
        <h3>{practice.provider.name}</h3>
        <p class="provider-detail">
          {practice.provider.title}<br />{practice.provider.experience}
        </p>
        <div class="button-row">
          <a class="button button--secondary" href="/about/"
            >About the Practice</a
          >
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Getting started</p><h2>
            A clear path for new patients
          </h2>
        </div>
        <p>
          There is no online intake or medical-information form on this website.
          Start by contacting the office directly.
        </p>
      </div>
      <ol class="steps grid grid--3">
        <li class="card">
          <strong>1</strong><h3>Learn about the practice</h3><p>
            Review the concierge model and frequently asked questions.
          </p>
        </li>
        <li class="card">
          <strong>2</strong><h3>Contact the office</h3><p>
            Call or use the practice’s patient communication email for general
            next-step information.
          </p>
        </li>
        <li class="card">
          <strong>3</strong><h3>Follow the office’s instructions</h3><p>
            The office will explain the next steps and provide any necessary
            instructions.
          </p>
        </li>
      </ol>
      <div class="button-row">
        <a class="button" href="/new-patients/">New Patient Information</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split contact-split">
      <div>
        <p class="eyebrow">Naples office</p>
        <h2>Visit our North Naples office.</h2>
        <p class="lede">Visit Naples Modern Choice Medicine in North Naples.</p>
        <address>
          {practice.address.street}<br />{practice.address.cityStateZip}
        </address>
        <a href={practice.mapUrl} target="_blank" rel="noopener noreferrer"
          >Open directions in Google Maps <span class="sr-only"
            >(opens in a new tab)</span
          ></a
        >
      </div>
      <ContactCard />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 8vw, 7rem);
    background:
      radial-gradient(
        circle at 96% 72%,
        rgba(255, 255, 255, 0.38) 0 2.4rem,
        transparent 2.45rem
      ),
      radial-gradient(
        circle at 72% 82%,
        transparent 0 1.4rem,
        rgba(36, 91, 85, 0.13) 1.45rem 1.53rem,
        transparent 1.58rem
      ),
      radial-gradient(
        circle at 92% 18%,
        rgba(135, 170, 163, 0.16) 0 3.5rem,
        transparent 3.55rem
      ),
      radial-gradient(
        circle at 80% 15%,
        rgba(135, 170, 163, 0.28),
        transparent 35%
      ),
      linear-gradient(135deg, var(--cream), #f3f7f4);
  }

  .hero::after {
    position: absolute;
    right: 2.5%;
    bottom: 12%;
    width: 1.25rem;
    height: 1.25rem;
    border: 1px solid rgba(36, 91, 85, 0.2);
    border-radius: 50%;
    box-shadow:
      -7rem -1rem 0 0.45rem rgba(255, 255, 255, 0.2),
      -3.5rem -8rem 0 -0.1rem rgba(36, 91, 85, 0.1);
    content: '';
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.9fr);
    align-items: center;
    gap: clamp(2rem, 7vw, 6rem);
  }
  .hero__note {
    margin-top: 1.1rem;
    color: var(--ink-soft);
    font-size: 0.84rem;
  }
  .intro {
    text-align: center;
  }
  .intro .lede {
    margin-inline: auto;
  }
  .intro .button-row {
    justify-content: center;
  }
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }
  .section-heading > p {
    max-width: 32rem;
    color: var(--ink-soft);
  }
  .provider-detail {
    color: var(--pine);
    font-weight: 750;
  }
  .steps {
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .steps strong {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    margin-bottom: 1.2rem;
    border-radius: 50%;
    background: var(--pine);
    color: var(--white);
  }
  address {
    margin-bottom: 1rem;
    font-style: normal;
    font-size: 1.1rem;
  }
  @media (max-width: 760px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .section-heading {
      display: block;
    }
  }
</style>
