---
import { practice } from '../data/practice';
import ContactLink from './ContactLink.astro';

interface Props {
  showAddress?: boolean;
}
const { showAddress = true } = Astro.props;
---

<div class="contact-card">
  <p class="eyebrow">Contact the office</p>
  <h2>We’re here to help with general questions.</h2>
  <ul class="contact-list">
    <li>
      <ContactLink
        href={practice.phone.href}
        label="Phone"
        value={practice.phone.display}
      />
    </li>
    <li>
      <ContactLink
        href={practice.email.href}
        label="Patient communication email"
        value={practice.email.display}
      />
    </li>
    {
      showAddress && (
        <li>
          <strong>Office</strong>
          {practice.address.street}
          <br />
          {practice.address.cityStateZip}
        </li>
      )
    }
  </ul>
</div>

<style>
  .contact-card {
    padding: clamp(1.75rem, 3vw, 2.5rem) 0 0;
    border-radius: var(--radius-lg);
    border-top: 1px solid var(--border);
    background: transparent;
  }

  h2 {
    max-width: 18ch;
    margin-bottom: 2.25rem;
    font-size: clamp(2rem, 2.6vw, 2.65rem);
  }

  .contact-list li:first-child :global(.contact-link__value) {
    font-size: 1rem;
    font-weight: 600;
  }
</style>
