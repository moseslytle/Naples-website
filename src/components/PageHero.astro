---
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lede">{intro}</p>
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    padding-block: clamp(4.5rem, 10vw, 8rem);
    overflow: hidden;
    background: linear-gradient(160deg, var(--cream) 50%, var(--mist) 100%);
  }

  .page-hero::after {
    position: absolute;
    top: -25%;
    right: -10%;
    width: 30rem;
    height: 30rem;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(135, 170, 163, 0.2),
      transparent 68%
    );
    content: '';
  }

  .page-hero .container {
    position: relative;
    z-index: 1;
  }

  h1 {
    max-width: 54rem;
  }
</style>
