---
import LogoMark from './LogoMark.astro';
interface Props {
  light?: boolean;
  eager?: boolean;
}
const { light = false, eager = false } = Astro.props;
---

<span class="wordmark">
  <LogoMark variant={light ? 'light' : 'dark'} eager={eager} />
  <span class="wordmark__type"
    ><span class="wordmark__name">Naples</span><span
      class="wordmark__descriptor">Modern Choice Medicine</span
    ></span
  >
</span>
<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    color: inherit;
  }
  .wordmark__type {
    display: block;
    text-align: center;
  }
  .wordmark__name {
    display: block;
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.14em;
    padding-left: 0.14em;
    text-transform: uppercase;
  }
  .wordmark__descriptor {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.5rem;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }
  @media (max-width: 620px) {
    .wordmark {
      gap: 0.6rem;
    }
    .wordmark__name {
      font-size: 1.9rem;
    }
    .wordmark__descriptor {
      font-size: 0.43rem;
      letter-spacing: 0.12em;
    }
    .wordmark :global(.mark) {
      width: 2rem;
      height: 2.25rem;
    }
  }
</style>
