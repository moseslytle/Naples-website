---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PracticeImage from '../components/PracticeImage.astro';
import { practice } from '../data/practice';
---

<BaseLayout
  title="About the Practice"
  description="Learn about Naples Modern Choice Medicine and its concierge family medicine approach."
>
  <PageHero
    eyebrow="About us"
    title="Personal family medicine in Naples."
    intro="Naples Modern Choice Medicine is a concierge family medicine practice led by Sandy P. Naples, D.O., F.A.A.F.P., a board-certified family physician with more than 30 years of experience in family medicine."
  >
    <p>
      His mission is to provide comprehensive healthcare to prioritize your
      wellness while recognizing the demands of your busy lifestyle.
    </p>
  </PageHero>
  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">The practice</p><h2>
          A more personal approach to care.
        </h2><p>
          Concierge family medicine supports a closer, ongoing relationship
          between patients and their family physician. The practice offers a
          setting where care can be thoughtful, personal, and clearly explained.
        </p>
      </div><PracticeImage
        src="/images/about-practice.webp"
        alt="Dr. Sandy Naples and a woman outside the Naples Modern Choice Medicine office"
      />
    </div>
  </section>
  <section class="section section--mist">
    <div class="container split">
      <PracticeImage
        src="/images/provider-portrait.webp"
        alt="Dr. Sandy Naples"
        portrait
      /><div>
        <p class="eyebrow">Your provider</p><h2>{practice.provider.name}</h2><p>
          <strong>{practice.provider.title}</strong><br />
          {practice.provider.experience}
        </p><p>
          With more than 30 years in family medicine, Dr. Naples combines
          traditional family medicine values with modern healthcare solutions,
          offering patients enhanced access, continuity of care, and
          individualized treatment plans.
        </p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="narrow prose">
      <p class="eyebrow">Background</p><h2>Education &amp; Credentials</h2>
      <ul class="credentials-list">
        <li>
          <strong>Doctor of Osteopathic Medicine</strong> — Ohio University Heritage
          College of Osteopathic Medicine
        </li>
        <li>
          <strong>Graduate Anatomy Studies</strong> — The Ohio State University
        </li>
        <li><strong>B.S. Biology</strong> — Youngstown State University</li>
        <li>
          <strong>Family Medicine Residency</strong> — St. Elizabeth Medical Center
        </li>
        <li>
          <strong>Board Certified</strong> — American Board of Family Medicine
        </li>
        <li>
          <strong>Associate Clinical Professor</strong> — Northeast Ohio Medical University
        </li>
        <li>
          <strong
            >Former Chairman, Department of Family Medicine &amp; Pediatrics</strong
          > — Mercy Health St. Elizabeth Medical Center
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .credentials-list {
    display: grid;
    gap: 1rem;
  }
</style>
