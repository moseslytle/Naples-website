---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PracticeImage from '../components/PracticeImage.astro';
import { practice } from '../data/practice';
---

<BaseLayout
  title="Concierge Care"
  description="A plain-language introduction to the concierge family medicine model at Naples Modern Choice Medicine."
>
  <PageHero
    eyebrow="Concierge care"
    title="Understanding concierge family medicine."
    intro="Concierge family medicine uses a membership model to support more personalized, ongoing primary care. Membership details, access, and included services vary by practice."
    ><div class="button-row">
      <a class="button" href="/new-patients/">New Patient Information</a><a
        class="button button--secondary"
        href={practice.phone.href}>Call the Practice</a
      >
    </div></PageHero
  >
  <section class="section">
    <div class="container split">
      <PracticeImage
        src="/images/concierge-consultation.webp"
        alt="Dr. Sandy Naples speaking with a seated woman in the office"
        objectPosition="center 35%"
      />
      <div class="prose">
        <h2>Questions to consider</h2><p>
          Before joining a concierge practice, it is helpful to understand the
          membership and how care is arranged.
        </p><ul>
          <li>What care and access does the membership include?</li><li>
            What costs may be separate from the membership?
          </li><li>
            How are urgent concerns handled during and outside office hours?
          </li><li>
            How does the practice coordinate care that happens elsewhere?
          </li><li>What is the process for joining or ending a membership?</li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
