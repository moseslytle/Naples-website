---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PracticeImage from '../components/PracticeImage.astro';
import { practice } from '../data/practice';
---

<BaseLayout
  title="Services"
  description="Contact Naples Modern Choice Medicine for information about available family medicine services and concierge membership."
>
  <PageHero
    eyebrow="Services"
    title="Family medicine services."
    intro="Contact the office for current information about available services, concierge membership, and whether the practice may be a good fit for your needs."
    ><div class="button-row">
      <a class="button" href={practice.phone.href}>Ask the Office</a>
    </div></PageHero
  >
  <section class="section">
    <div class="container split">
      <div class="prose">
        <h2>General information</h2><p>
          This website provides general information only. It does not establish
          a patient-provider relationship, replace individualized medical
          advice, or provide diagnosis or treatment.
        </p>
      </div>
      <PracticeImage
        src="/images/services-care.webp"
        alt="Dr. Sandy Naples using a stethoscope while examining a seated woman"
        objectPosition="center 38%"
      />
    </div>
  </section>
</BaseLayout>
