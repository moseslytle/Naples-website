---
import { practice } from '../data/practice';
---

<div class="contact-card">
  <p class="eyebrow">Contact the office</p>
  <h2>We’re here to help with general questions.</h2>
  <ul class="contact-list">
    <li>
      <strong>Phone</strong><a href={practice.phone.href}
        >{practice.phone.display}</a
      >
    </li>
    <li>
      <strong>Patient communication email</strong><a href={practice.email.href}
        >{practice.email.display}</a
      >
    </li>
    <li>
      <strong>Office</strong>{practice.address.street}<br />{
        practice.address.cityStateZip
      }
    </li>
  </ul>
</div>

<style>
  .contact-card {
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow);
    transition:
      box-shadow 220ms ease-out,
      transform 220ms ease-out;
  }

  h2 {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
  }

  @media (hover: hover) {
    .contact-card:hover {
      box-shadow: 0 20px 52px rgba(24, 52, 50, 0.12);
      transform: translateY(-1px);
    }
  }
</style>
