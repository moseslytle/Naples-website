---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PracticeImage from '../components/PracticeImage.astro';
import { practice } from '../data/practice';
---

<BaseLayout
  title="Contact & Directions"
  description="Contact details, location, and directions for Naples Modern Choice Medicine in Naples, Florida."
>
  <PageHero
    eyebrow="Contact & location"
    title="Contact the office."
    intro="Call or use the patient communication email for general questions and next steps. Online booking is not available on this website."
  />
  <section class="section">
    <div class="container contact-grid">
      <div class="card">
        <h2>Office details</h2><ul class="contact-list">
          <li>
            <strong>Address</strong><address>
              {practice.address.street}<br />{practice.address.cityStateZip}
            </address>
          </li><li>
            <strong>Phone</strong><a href={practice.phone.href}
              >{practice.phone.display}</a
            >
          </li><li><strong>Fax</strong>{practice.fax}</li><li>
            <strong>Patient communication email</strong><a
              class="email"
              href={practice.email.href}>{practice.email.display}</a
            >
          </li>
        </ul><div class="button-row">
          <a class="button" href={practice.phone.href}>Call the Practice</a><a
            class="button button--secondary"
            href={practice.mapUrl}
            target="_blank"
            rel="noopener noreferrer"
            >Get Directions<span class="sr-only"> (opens in a new tab)</span></a
          >
        </div>
      </div><PracticeImage
        src="/images/contact-exterior.webp"
        alt="Naples Modern Choice Medicine sign on the office building"
      />
    </div>
  </section>
  <section class="section section--sand">
    <div class="narrow prose">
      <h2>Before you contact us</h2><p>
        Do not use email for emergencies. Call 911 in an emergency.
      </p><p>
        Follow office guidance before sending medical or other sensitive
        personal information. This public website does not provide a secure
        contact or intake form.
      </p>
    </div>
  </section>
</BaseLayout>
<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(18rem, 0.82fr) minmax(24rem, 1.18fr);
    align-items: stretch;
    gap: 2rem;
  }
  address {
    font-style: normal;
  }
  .email {
    overflow-wrap: anywhere;
  }
  @media (max-width: 760px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
