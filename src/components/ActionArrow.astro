---
interface Props {
  direction?: 'forward' | 'down' | 'outward';
  class?: string;
}
const { direction = 'forward', class: className } = Astro.props;
const paths = {
  forward: 'M4 10h12M11 5l5 5-5 5',
  down: 'M10 4v12M5 11l5 5 5-5',
  outward: 'M5 15 15 5M5 5h10v10',
};
---

<svg
  class={className}
  width="20"
  height="20"
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[direction]}></path>
</svg>
