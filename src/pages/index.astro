---
import BaseLayout from '../layouts/BaseLayout.astro';
import PracticeImage from '../components/PracticeImage.astro';
import ContactCard from '../components/ContactCard.astro';
import { practice, sitePath } from '../data/practice';
---

<BaseLayout
  title={practice.name}
  description="A welcoming introduction to Naples Modern Choice Medicine, a concierge family medicine practice in Naples, Florida."
>
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <p class="eyebrow">Concierge family medicine · Naples, Florida</p>
        <h1>A more personal approach to family medicine.</h1>
        <p class="lede">
          Naples Modern Choice Medicine offers concierge family medicine with
          more time for thoughtful, ongoing care and a closer relationship with
          your physician.
        </p>
        <div class="button-row">
          <a class="button" href={practice.phone.href}>Call the Practice</a>
          <a
            class="button button--secondary"
            href={sitePath('/concierge-care/')}>Learn About Concierge Care</a
          >
        </div>
        <p class="hero__note">
          Appointments are arranged by contacting the office. Online booking is
          not available.
        </p>
      </div>
      <PracticeImage
        src="/images/practice-hero.webp"
        alt="Naples Modern Choice Medicine office building and entrance"
        eager
      />
    </div>
  </section>

  <section class="section intro">
    <div class="narrow">
      <h2>What concierge family medicine means</h2>
      <p class="lede">
        Concierge family medicine uses a membership model to support more
        personalized, ongoing primary care. Membership details, access, and
        included services vary by practice.
      </p>
      <div class="button-row">
        <a class="button button--secondary" href={sitePath('/concierge-care/')}
          >How Concierge Care Works</a
        >
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <PracticeImage
        src="/images/provider-portrait.webp"
        alt="Dr. Sandy Naples"
        portrait
      />
      <div>
        <h2>Meet Dr. Sandy Naples.</h2>
        <h3>{practice.provider.name}</h3>
        <p class="provider-detail">
          {practice.provider.title}<br />{practice.provider.experience}
        </p>
        <p>
          His mission is to provide comprehensive healthcare that prioritizes
          your wellness while recognizing the demands of your busy lifestyle.
        </p>
        <div class="button-row">
          <a class="button button--secondary" href={sitePath('/about/')}
            >About the Practice</a
          >
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <div class="section-heading">
        <div>
          <h2>A clear path for new patients</h2>
        </div>
        <p>
          There is no online intake or medical-information form on this website.
          Start by contacting the office directly.
        </p>
      </div>
      <ol class="steps grid grid--3">
        <li class="card">
          <strong>1</strong><h3>Learn about the practice</h3><p>
            Review the concierge model and frequently asked questions.
          </p>
        </li>
        <li class="card">
          <strong>2</strong><h3>Contact the office</h3><p>
            Call or use the practice’s patient communication email for general
            next-step information.
          </p>
        </li>
        <li class="card">
          <strong>3</strong><h3>Follow the office’s instructions</h3><p>
            The office will explain the next steps and provide any necessary
            instructions.
          </p>
        </li>
      </ol>
      <div class="button-row">
        <a class="button" href={sitePath('/new-patients/')}
          >New Patient Information</a
        >
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split contact-split">
      <div>
        <p class="eyebrow">Naples office</p>
        <h2>Visit our North Naples office.</h2>
        <p class="lede">Visit Naples Modern Choice Medicine in North Naples.</p>
        <address>
          {practice.address.street}<br />{practice.address.cityStateZip}
        </address>
        <a href={practice.mapUrl} target="_blank" rel="noopener noreferrer"
          >Open directions in Google Maps <span class="sr-only"
            >(opens in a new tab)</span
          ></a
        >
      </div>
      <ContactCard />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 8vw, 7rem);
    background: linear-gradient(160deg, var(--cream) 45%, var(--mist) 100%);
  }

  .hero::after {
    position: absolute;
    top: -18%;
    right: -8%;
    width: 26rem;
    height: 26rem;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(135, 170, 163, 0.22),
      transparent 68%
    );
    content: '';
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.9fr);
    align-items: center;
    gap: clamp(2rem, 7vw, 6rem);
  }
  .hero__note {
    margin-top: 1.1rem;
    color: var(--ink-soft);
    font-size: 0.84rem;
  }
  .intro {
    text-align: center;
  }
  .intro .lede {
    margin-inline: auto;
  }
  .intro .button-row {
    justify-content: center;
  }
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }
  .section-heading > p {
    max-width: 32rem;
    color: var(--ink-soft);
  }
  .provider-detail {
    color: var(--pine);
    font-weight: 750;
  }
  .steps {
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .steps strong {
    display: block;
    margin-bottom: 0.9rem;
    color: var(--sea);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 2.1rem;
    font-weight: 480;
    line-height: 1;
  }
  address {
    margin-bottom: 1rem;
    font-style: normal;
    font-size: 1.1rem;
  }
  @media (max-width: 760px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .section-heading {
      display: block;
    }
  }
</style>
