---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { practice } from '../data/practice';
---

<BaseLayout
  title="Privacy & Website Disclaimer"
  description="Draft privacy information and website disclaimer for Naples Modern Choice Medicine."
>
  <PageHero
    eyebrow="Draft for client review"
    title="Privacy & website disclaimer"
    intro="The wording on this page is general draft copy. It must be reviewed and approved by the practice and qualified legal counsel before publication."
  />
  <section class="section">
    <div class="narrow prose">
      <h2>General information only</h2><p>
        This website provides general educational and practice information. Its
        content is not medical advice and is not a substitute for advice,
        diagnosis, or treatment from a qualified health care professional.
      </p><p>
        Viewing this website or contacting the practice does not by itself
        establish a patient-provider relationship.
      </p><h2>Emergencies</h2><p>
        This website and the listed email address are not for medical
        emergencies. If you are experiencing a medical emergency, call 911.
      </p><h2>Medications and pharmaceuticals</h2><p>
        Medications and pharmaceuticals are not sold through this website.
      </p><h2>Information collected by this website</h2><p>
        This website does not include account registration, online booking,
        intake forms, payment processing, analytics, advertising trackers, or a
        custom contact form.
      </p><p>
        Basic technical information may still be processed by the hosting
        provider when a visitor requests a webpage.
      </p><h2>Email and external services</h2><p>
        Links to email, maps, and other external services open tools operated by
        third parties. Their privacy practices apply when you use them. Do not
        send sensitive medical information unless the practice has instructed
        you to use an approved method.
      </p><h2>Website accuracy</h2><p>
        The practice intends to keep its website information clear and current,
        but content may change. Contact the office to confirm information
        relevant to your needs.
      </p><h2>Contact</h2><p>
        Questions about this draft website policy may be directed to Naples
        Modern Choice Medicine at <a href={practice.phone.href}
          >{practice.phone.display}</a
        > or <a href={practice.email.href}>{practice.email.display}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
