---
import Wordmark from './Wordmark.astro';
import ActionArrow from './ActionArrow.astro';
import { navigation, practice, sitePath } from '../data/practice';

const { pathname } = Astro.url;
const homePath = sitePath('/');
const isActive = (href: string) =>
  href === homePath ? pathname === homePath : pathname.startsWith(href);
---

<a class="skip-link" href="#main-content">Skip to main content</a>
<div class="header-sentinel" aria-hidden="true"></div>
<header class="site-header">
  <div class="container nav-wrap">
    <div class="header-contact">
      <span>Naples, Florida</span><a href={practice.phone.href}
        >{practice.phone.display}</a
      >
    </div>
    <a class="brand" href={homePath} aria-label={`${practice.name} home`}>
      <Wordmark eager />
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      <ul>
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="header-actions">
      <span class="payment-label">Member payments</span>
      <a
        class="header-payment"
        href={practice.paymentUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Pay Now <ActionArrow direction="outward" />
        <span class="sr-only"> (PayerExpress, opens in a new tab)</span>
      </a>
      <a class="button header-cta" href={sitePath('/contact/')}
        >Schedule an Appointment</a
      >
    </div>
    <details class="mobile-nav">
      <summary>Menu<span class="menu-icon" aria-hidden="true"></span></summary>
      <nav aria-label="Mobile navigation">
        <ul>
          {
            navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="button" href={sitePath('/contact/')}
          >Schedule an Appointment</a
        >
        <a class="mobile-phone" href={practice.phone.href}
          >Call {practice.phone.display}</a
        >
      </nav>
    </details>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const sentinel = document.querySelector('.header-sentinel');
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
  const summary = menu?.querySelector('summary');
  const menuPanel = menu?.querySelector('nav');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let menuAnimation: Animation | undefined;

  if (header && sentinel && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      header.classList.toggle('is-scrolled', !entry.isIntersecting);
    }).observe(sentinel);
  }
  const closeMenu = (restoreFocus = false) => {
    if (!menu?.open) return;
    if (restoreFocus) summary?.focus();
    if (menuAnimation) return;
    if (reducedMotion.matches || !menuPanel || !('animate' in menuPanel)) {
      menu.open = false;
      return;
    }
    menuAnimation = menuPanel.animate(
      { opacity: [1, 0], transform: ['translateY(0)', 'translateY(-6px)'] },
      { duration: 180, easing: 'ease-out' },
    );
    menuAnimation.onfinish = () => {
      menu.open = false;
      menuAnimation = undefined;
    };
  };
  summary?.addEventListener('click', (event) => {
    if (!menu?.open) return;
    event.preventDefault();
    if (menuAnimation) {
      menuAnimation.cancel();
      menuAnimation = undefined;
    } else closeMenu();
  });
  reducedMotion.addEventListener('change', (event) => {
    if (event.matches) menuAnimation?.finish();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) closeMenu(true);
  });
  document.addEventListener('click', (event) => {
    if (event.target instanceof Node && !menu?.contains(event.target))
      closeMenu();
  });
  menu?.addEventListener('focusout', (event) => {
    if (
      event.relatedTarget instanceof Node &&
      !menu.contains(event.relatedTarget)
    )
      closeMenu();
  });
  window
    .matchMedia('(min-width: 1201px)')
    .addEventListener('change', (event) => {
      if (event.matches && menu) {
        menuAnimation?.cancel();
        menuAnimation = undefined;
        menu.open = false;
      }
    });
</script>

<style>
  .skip-link {
    position: fixed;
    z-index: 100;
    top: 0.5rem;
    left: 0.5rem;
    padding: 0.7rem 1rem;
    background: var(--cream);
    transform: translateY(-150%);
  }
  .skip-link:focus {
    transform: translateY(0);
  }
  .header-sentinel {
    position: absolute;
    top: 0;
    height: 1px;
    width: 1px;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--cream);
    color: var(--ink);
    border-bottom: 1px solid var(--border);
    transition: box-shadow 250ms ease;
  }
  .site-header.is-scrolled {
    box-shadow: 0 6px 24px #13261e22;
  }
  .nav-wrap {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-areas: 'contact brand cta' 'nav nav nav';
    align-items: center;
    column-gap: 2rem;
    padding-top: 1.5rem;
  }
  .header-contact {
    grid-area: contact;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    line-height: 1.8;
  }
  .header-contact span {
    display: block;
    color: var(--ink-soft);
    text-transform: uppercase;
    font-size: 0.625rem;
  }
  .header-contact a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--ink);
    text-decoration: none;
  }
  .brand {
    grid-area: brand;
    display: flex;
    color: inherit;
    text-decoration: none;
  }
  .brand:hover {
    color: var(--ink-soft);
  }
  .desktop-nav {
    grid-area: nav;
    padding-block: 0.75rem 0.45rem;
  }
  .desktop-nav ul {
    display: flex;
    justify-content: center;
    gap: clamp(1.5rem, 3vw, 3rem);
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .desktop-nav a {
    position: relative;
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--ink-soft);
    font-size: 0.625rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }
  .desktop-nav a::after {
    position: absolute;
    bottom: 0.5rem;
    inset-inline: 0;
    height: 1px;
    background: var(--pine);
    content: '';
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration) var(--ease);
  }
  .desktop-nav a:hover,
  .desktop-nav a[aria-current='page'] {
    color: var(--ink);
  }
  .desktop-nav a:hover::after,
  .desktop-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .header-cta {
    grid-area: cta;
    justify-self: end;
    background: transparent;
    border-color: var(--ink);
    color: var(--ink);
    min-height: 2.875rem;
    font-size: 0.625rem;
    padding: 0.85rem 1.25rem;
  }
  .header-actions {
    grid-area: cta;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .payment-label {
    display: none;
  }
  .header-payment {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    color: var(--pine-dark);
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }
  .header-payment :global(svg) {
    width: 1rem;
    height: 1rem;
  }
  .header-payment:hover {
    color: var(--pine);
    text-decoration-thickness: 2px;
  }
  .header-cta:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--cream);
  }
  .site-header :is(a, summary):focus-visible {
    outline-color: var(--coral);
    box-shadow: none;
  }
  .mobile-nav {
    display: none;
    grid-area: menu;
  }
  .mobile-nav summary {
    display: flex;
    min-height: 3rem;
    gap: 0.8rem;
    align-items: center;
    padding: 0.65rem 0;
    cursor: pointer;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    list-style: none;
  }
  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }
  .menu-icon {
    position: relative;
    width: 1.25rem;
    height: 0.625rem;
  }
  .menu-icon::before,
  .menu-icon::after {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    content: '';
    transition:
      transform 220ms ease,
      top 220ms ease;
  }
  .menu-icon::before {
    top: 0;
  }
  .menu-icon::after {
    top: 0.5rem;
  }
  .mobile-nav[open] .menu-icon::before {
    top: 0.25rem;
    transform: rotate(45deg);
  }
  .mobile-nav[open] .menu-icon::after {
    top: 0.25rem;
    transform: rotate(-45deg);
  }
  .mobile-nav nav {
    position: absolute;
    top: 100%;
    right: 0;
    width: min(27rem, calc(100vw - var(--gutter) * 2));
    max-height: calc(100dvh - 7rem);
    overflow-y: auto;
    padding: 1.5rem;
    background: var(--cream);
    border: 1px solid var(--border);
  }
  .mobile-nav[open] nav {
    animation: menu-in 250ms var(--ease) both;
  }
  .mobile-nav ul {
    display: block;
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
  }
  .mobile-nav li + li {
    border-top: 1px solid var(--border);
  }
  .mobile-nav li a {
    display: flex;
    min-height: 3rem;
    align-items: center;
    padding-inline: 0.5rem;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.65rem;
    text-decoration: none;
  }
  .mobile-nav li a:hover,
  .mobile-nav li a[aria-current='page'] {
    color: var(--pine);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
  .mobile-nav .button {
    width: 100%;
    background: var(--pine-dark);
    color: var(--cream);
  }
  .mobile-phone {
    display: flex;
    min-height: 2.75rem;
    margin-top: 0.75rem;
    color: var(--ink);
    justify-content: center;
    align-items: center;
    font-size: var(--type-small);
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (max-width: 1200px) {
    .nav-wrap {
      grid-template-columns: 1fr auto auto;
      grid-template-areas: 'brand cta menu';
      min-height: 6.5rem;
      padding-block: 1rem;
    }
    .desktop-nav,
    .header-contact,
    .header-cta {
      display: none;
    }
    .mobile-nav {
      display: block;
    }
    .brand {
      justify-self: start;
    }
  }
  @media (max-width: 620px) {
    .nav-wrap {
      grid-template-columns: 1fr auto;
      grid-template-areas: 'brand menu' 'cta cta';
      min-height: 5.5rem;
      column-gap: 1rem;
    }
    .header-cta {
      display: none;
    }
    .header-actions {
      justify-self: stretch;
      justify-content: flex-end;
      margin-top: 0.5rem;
      border-top: 1px solid var(--border);
    }
    .payment-label {
      display: block;
      margin-right: auto;
      font-size: 0.75rem;
      color: var(--ink);
    }
    .mobile-nav nav {
      max-height: calc(100dvh - 10rem);
      padding: 1rem;
    }
  }
</style>
